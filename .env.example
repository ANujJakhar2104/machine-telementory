# Copy to your hosting dashboard (or export locally). Never commit real secrets.
NODE_ENV=production
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
DEVICE_API_KEY=change-me-device-key
DB_PATH=data/telemetry.db
# Built-in machine simulator (set to "off" when real machines send data to POST /api/v1/telemetry)
SIMULATOR=on
SIMULATOR_INTERVAL_MS=2000
RAW_RETENTION_HOURS=48
# Create demo accounts and show them on the login page (set false for a real deployment)
SEED_DEMO_USERS=true
# Comma-separated origins allowed to call the API from other sites (optional)
CORS_ORIGINS=
